; ===========================================================================
; directinput.bfa - role DIRECTINPUT: the force-feedback effect driver
; ===========================================================================
;
; Reproduces the legacy G29EffectDriver and ForceFeedbackSession. The bridge is
; a COM shell: it serializes every IDirectInputEffectDriver call into an
; EV_DI_* event (ABI.md), waits for CMD_DI_RETURN and copies the returned
; values to the caller's buffers. Everything the driver decides is here: which
; device is acceptable, the HRESULTs, the effect table, the 2 ms force loop,
; the direction mapping, the stop report when a session ends, the steering
; reader's polling and the heartbeat for the service watchdog.
;
; Session (DeviceID with begin != 0), in order, like the legacy constructor:
;   identity (Logitech, native G29 product), open the interface for output,
;   locate the steering axis (usage page 1, usage X = 0x30) and start reading
;   it, poll it once, open the heartbeat shared memory (optional), start the
;   2 ms timer. Any failure closes what was opened and answers E_FAIL.
; Session end (DeviceID again, or process exit): stop the timer, send the
; zero-force (stop) report, beat "inactive", close everything.
;
; Force loop (timer 1, every 2 ms): poll the wheel when no steering report
; arrived for 250 ms (at most every 100 ms), compute the effect mix, map it to
; the protocol percent, send the report only when the percent changed, and
; beat. Direction convention (DirectInput: an effect's direction is where the
; force comes from, so a positive force along X pushes toward negative X, the
; left): percent = round(force / 100), half away from zero; a positive protocol
; percent turns the G29 left (measured on hardware: -25 turns it right, and ACC
; asks for positive force while the wheel is right of centre). The engine
; computes condition effects as opposing a displacement with the opposite sign
; convention, so the motion it receives is mirrored: springs and dampers keep
; resisting the wheel while every other effect follows DirectInput. A failed
; write marks the device lost and ends the loop (no more beats, so the service
; watchdog stops the wheel if force was left behind).

const EV_HID_INPUT = 0x15
const EV_HID_USAGE_RESULT = 0x16
const EV_HID_DISCONNECTED = 0x17
const EV_HID_POLL_RESULT = 0x18
const EV_DI_FIRST = 0x50
const EV_DI_LAST = 0x5A

const HR_OK = 1
const HR_INVALID = 2
const HR_GENERIC = 3
const HR_UNSUPPORTED = 4
const HR_NOTINIT = 5
const HR_FULL = 6

; continuations (run_services)
const K_NOP = 10
const K_DI_OK = 11
const K_DI_STATUS = 12
const K_DI_STATE = 13
const K_DI_PLAYING = 14
const K_DL1 = 15
const K_DL2 = 16
const K_DL3 = 17
const K_DL4 = 18
const K_TICK1 = 19
const K_TICK2 = 20

; DeviceID steps
const DS_OPEN = 1
const DS_CAPS = 2
const DS_READ = 3
const DS_POLL = 4
const DS_SHM = 5

; ---------------------------------------------------------------------------
; Commands
; ---------------------------------------------------------------------------

macro out_hresult(code) {
    if code == HR_OK { out_const(0) out_const(0) out_const(0) out_const(0) }
    if code == HR_INVALID { out_const(0x57) out_const(0x00) out_const(0x07) out_const(0x80) }
    if code == HR_GENERIC { out_const(0x05) out_const(0x40) out_const(0x00) out_const(0x80) }
    if code == HR_UNSUPPORTED { out_const(0x01) out_const(0x40) out_const(0x00) out_const(0x80) }
    if code == HR_NOTINIT { out_const(0x15) out_const(0x00) out_const(0x07) out_const(0x80) }
    if code == HR_FULL { out_const(0x01) out_const(0x02) out_const(0x04) out_const(0x80) }
}

; CMD_DI_RETURN header with the sequence of the pending DirectInput call.
macro di_header(length) {
    out_const(0xA5)
    out_const(1)
    out_const(0xD0)
    out_const(0)
    put(di_sq)
    put(di_sq + 1)
    out_u16_const(length)
}

; CMD_DI_RETURN without output values.
macro di_return(code) {
    di_header(5)
    out_hresult(code)
    out_const(0)
    clear(di_pend)
}

; one output value: offset u16 (constant), value u32 (cell)
macro di_output(offset, value) {
    out_u16_const(offset)
    out_u32(value)
}

macro emit_token_cmd(type) {
    emit_header(type, 4)
    put_token(di_tok)
}

macro emit_axis_cmd(type) {
    emit_header(type, 8)
    put_token(di_tok)
    out_u16_const(0x01)
    out_u16_const(0x30)
}

macro emit_timer_cancel() {
    emit_header(0xA1, 1)
    out_const(1)
}

; CMD_SHM_WRITE: tick (8 bytes) and the active flag (u32) at offset 0.
macro emit_beat(active) {
    emit_header(0xCB, 22)
    put_token(di_hh)
    for i = 0 to 3 { out_const(0) }
    out_u16_const(12)
    for i = 0 to 7 { put(di_tms + i) }
    put(active)
    for i = 0 to 2 { out_const(0) }
}

; CMD_HID_WRITE of the report in rpt[0..6] to the session's wheel.
macro emit_force_write() {
    emit_header(0x93, 13)
    put_token(di_tok)
    out_u16_const(7)
    for k = 0 to 6 { put(rpt + k) }
}

; flag += (the 4 token bytes in t equal di_tok)
macro token_is_ours(t, flag) {
    local same {
        set(same, 1)
        for k = 0 to 3 {
            local e { eq(t + k, di_tok + k, e) if_z(e) { clear(same) } clear(e) }
        }
        move(same, flag)
    }
}

; ---------------------------------------------------------------------------
; Session
; ---------------------------------------------------------------------------

; Ends the session (legacy ForceFeedbackSession.Dispose): no more ticks, the
; stop report, "inactive" heartbeat, everything closed. Also used on shutdown.
macro di_close() {
    if_nz(di_act) {
        emit_timer_cancel()
        clear(pr_arg1)
        clear(pr_arg2)
        proto_force()
        emit_force_write()
        rpt_clear()
        clear(pr_count)
        if_nz(di_heart) {
            local zero { emit_beat(zero) }
            emit_header(0xCC, 4)
            put_token(di_hh)
        }
        emit_token_cmd(0x95)
        emit_token_cmd(0x92)
    }
    clear(di_act)
    clear(di_lost)
    clear(di_sent)
    clear(di_ln)
    clear(di_lm)
    clear(di_heart)
    clear(di_polled)
    w_clear(di_poll)
    for k = 0 to 3 { clear(di_tok + k) clear(di_hh + k) }
    clear(di_rev)
    clear(di_rev + 1)
    clear(st_has)
}

; A DeviceID step failed: close what was opened, answer E_FAIL.
macro di_open_failed(opened) {
    if opened == 1 { emit_token_cmd(0x92) }
    for k = 0 to 3 { clear(di_tok + k) }
    clear(di_rev)
    clear(di_rev + 1)
    clear(di_step)
    di_return(HR_GENERIC)
}

; EV_DI_DEVICE_ID (after now)
macro di_device_id() {
    local begin, present, size, needed, inspected, t[4], v[2], p[2], r[2] {
        local skip[3] { w_read_u32(skip) w_read_u32(skip) w_clear(skip) }
        read_u32_nz(begin)
        local skip[3] { w_read_u32(skip) w_clear(skip) }
        frame_in(present)
        read_u32_cell(size)
        read_u32_cell(needed)
        frame_in(inspected)
        for k = 0 to 3 { frame_in(t + k) }
        frame_in(v)
        frame_in(v + 1)
        frame_in(p)
        frame_in(p + 1)
        frame_in(r)
        frame_in(r + 1)
        ; the previous session ends and a new one gets a new effect table
        di_close()
        set(e_cmd, EC_RESET)
        clear(e_gain)
        set(e_gain, FULL)
        clear(e_next)
        set(e_next, 1)
        set(svc, K_NOP)
        local done {
            if_z(begin) { set(done, 1) di_return(HR_OK) }
            if_z(done) {
                local bad {
                    lt(size, needed, bad)
                    if_z(present) { set(bad, 1) }
                    if_nz(bad) { set(done, 1) di_return(HR_INVALID) }
                    clear(bad)
                }
            }
            if_z(done) {
                ; a native-mode Logitech G29 only
                local ok {
                    set(pr_arg1, 0)
                    copy(p + 1, pr_arg1)
                    copy(p, pr_arg2)
                    copy(r + 1, pr_arg3)
                    copy(r, pr_arg4)
                    proto_identify()
                    local bit0, q { copy(pr_flags, q) divmod_const(q, 2, bit0, ok) clear(bit0) }
                    clear(pr_arg1)
                    clear(pr_arg2)
                    clear(pr_arg3)
                    clear(pr_arg4)
                    clear(pr_flags)
                    if_ne(v, 0x6D) { clear(ok) }
                    if_ne(v + 1, 0x04) { clear(ok) }
                    if_z(inspected) { clear(ok) }
                    if_nz_else(ok) {
                        for k = 0 to 3 { copy(t + k, di_tok + k) }
                        copy(r, di_rev)
                        copy(r + 1, di_rev + 1)
                        emit_token_cmd(0x91)
                        set(di_step, DS_OPEN)
                    } { di_return(HR_GENERIC) }
                    clear(ok)
                }
            }
            clear(done)
        }
        clear(begin)
        clear(present)
        clear(size)
        clear(needed)
        clear(inspected)
        for k = 0 to 3 { clear(t + k) }
        for k = 0 to 1 { clear(v + k) clear(p + k) clear(r + k) }
    }
}

; Results of the DeviceID steps.
macro di_on_step_result() {
    local t[4], mine {
        if_ne(fr_type, EV_SHM_RESULT) {
            for k = 0 to 3 { frame_in(t + k) }
            token_is_ours(t, mine)
        }
        if_eq(fr_type, EV_SHM_RESULT) { set(mine, 1) }
        if_nz(mine) {
            local step { copy(di_step, step)
                if_eq(fr_type, EV_HID_OPEN_RESULT) {
                    local err {
                        read_u32_nz(err)
                        if_eq(step, DS_OPEN) {
                            if_nz_else(err) { di_open_failed(0) } {
                                emit_axis_cmd(0x97)
                                set(di_step, DS_CAPS)
                            }
                        }
                        if_eq(step, DS_READ) {
                            if_nz_else(err) { di_open_failed(1) } {
                                emit_token_cmd(0x96)
                                set(di_step, DS_POLL)
                            }
                        }
                        clear(err)
                    }
                }
                if_eq(fr_type, EV_HID_USAGE_RESULT) {
                    if_eq(step, DS_CAPS) {
                        local err {
                            read_u32_nz(err)
                            if_nz_else(err) { di_open_failed(1) } {
                                read_i32_wide(st_minn, st_min)
                                read_i32_wide(st_maxn, st_max)
                                clear(st_bits)
                                frame_in_u16(st_bits)
                                set(st_req, 1)
                                set(svc, K_NOP)
                                emit_axis_cmd(0x94)
                                set(di_step, DS_READ)
                            }
                            clear(err)
                        }
                    }
                }
                if_eq(fr_type, EV_HID_POLL_RESULT) {
                    if_eq(step, DS_POLL) {
                        ; the heartbeat of the service watchdog, if the service runs
                        emit_header(0xC9, 41)
                        emit_heartbeat_name()
                        out_const(16)
                        for k = 0 to 2 { out_const(0) }
                        set(di_step, DS_SHM)
                    }
                }
                if_eq(fr_type, EV_SHM_RESULT) {
                    if_eq(step, DS_SHM) {
                        local err {
                            read_u32_nz(err)
                            if_z(err) {
                                set(di_heart, 1)
                                for k = 0 to 3 { frame_in(di_hh + k) }
                            }
                            clear(err)
                        }
                        ; CMD_TIMER_ARM: timer 1, repeating, 2 ms
                        emit_header(0xA0, 6)
                        out_const(1)
                        out_const(1)
                        out_const(2)
                        for k = 0 to 2 { out_const(0) }
                        set(di_act, 1)
                        clear(di_step)
                        di_return(HR_OK)
                    }
                }
                clear(step)
            }
        }
        clear(mine)
        for k = 0 to 3 { clear(t + k) }
    }
}

; ---------------------------------------------------------------------------
; Force loop
; ---------------------------------------------------------------------------

macro di_on_timer() {
    local id {
        frame_in(id)
        w_read_u64(di_now)
        for k = 0 to 7 { frame_in(di_tms + k) }
        if_eq(id, 1) {
            if_nz(di_act) {
                if_z(di_lost) {
                    ; poll a wheel at rest: no report for 250 ms, at most every 100 ms
                    local need {
                        if_z(st_has) { set(need, 1) }
                        if_nz(st_has) {
                            local d[3], neg {
                                w_copy(di_now, d)
                                w_sub_signed(d, st_last, neg)
                                local m[3] { set(m, 62500) w_mul_const(m, 4) @m + w_ge(d, m, need) w_clear(m) }
                                if_nz(neg) { clear(need) }
                                w_clear(d)
                                clear(neg)
                            }
                        }
                        if_nz(need) {
                            if_nz(di_polled) {
                                local d[3], neg, late {
                                    w_copy(di_now, d)
                                    w_sub_signed(d, di_poll, neg)
                                    local m[3] { set(m, 50000) w_mul_const(m, 2) w_ge(d, m, late) w_clear(m) }
                                    if_nz(neg) { clear(late) }
                                    if_z(late) { clear(need) }
                                    w_clear(d)
                                    clear(neg)
                                    clear(late)
                                }
                            }
                        }
                        if_nz(need) {
                            emit_token_cmd(0x96)
                            w_clear(di_poll)
                            w_copy(di_now, di_poll)
                            set(di_polled, 1)
                        }
                        clear(need)
                    }
                    w_copy(di_now, st_now)
                    set(st_req, 3)
                    set(svc, K_TICK1)
                }
            }
        }
        clear(id)
    }
}

; after the steering motion: the effect mix
macro di_tick1() {
    ; mirrored (see the header); zero is never negative
    if_nz(st_op) { if_z(st_opn) { set(e_motion, 1) } }
    copy(st_op, e_motion + 1)
    if_nz(st_ov) { if_z(st_ovn) { set(e_motion + 2, 1) } }
    copy(st_ov, e_motion + 3)
    if_nz(st_oa) { if_z(st_oan) { set(e_motion + 4, 1) } }
    copy(st_oa, e_motion + 5)
    w_clear(st_now)
    w_copy(di_now, e_now)
    set(e_cmd, EC_FORCE)
    set(svc, K_TICK2)
}

; after the mix: the report and the heartbeat
macro di_tick2() {
    local neg, mag, changed {
        ; percent = round(force / 100), half away from zero
        local f { copy(e_result, f) add(f, 50) div_const(f, 100, mag) }
        if_nz(mag) { if_nz(e_res_neg) { set(neg, 1) } }
        if_z(di_sent) { set(changed, 1) }
        local e { eq(mag, di_lm, e) if_z(e) { set(changed, 1) } clear(e) }
        local e { eq(neg, di_ln, e) if_z(e) { set(changed, 1) } clear(e) }
        if_nz(changed) {
            copy(neg, pr_arg1)
            copy(mag, pr_arg2)
            proto_force()
            emit_force_write()
            rpt_clear()
            clear(pr_count)
            clear(pr_arg1)
            clear(pr_arg2)
            set(di_sent, 1)
            clear(di_ln)
            copy(neg, di_ln)
            clear(di_lm)
            copy(mag, di_lm)
        }
        if_nz(di_heart) {
            local active {
                if_nz(mag) { set(active, 1) }
                emit_beat(active)
                clear(active)
            }
        }
        clear(neg)
        clear(mag)
        clear(changed)
    }
    eng_inputs_clear()
}

; ---------------------------------------------------------------------------
; DirectInput calls
; ---------------------------------------------------------------------------

macro di_call() {
    clear(di_pend)
    copy(fr_type, di_pend)
    add(di_pend, 0 - (EV_DI_FIRST - 1))
    clear(di_sq)
    clear(di_sq + 1)
    copy(fr_seq_lo, di_sq)
    copy(fr_seq_hi, di_sq + 1)
    w_read_u64(di_now)
    local m {
        copy(di_pend, m)
        if_eq(m, 1) { di_device_id() }
        ; GetVersions
        if_eq(m, 2) {
            local present, size, bad {
                frame_in(present)
                read_u32_cell(size)
                lt_const(size, 16, bad)
                if_z(present) { set(bad, 1) }
                if_nz_else(bad) { di_return(HR_INVALID) } {
                    di_header(23)
                    out_hresult(HR_OK)
                    out_const(3)
                    for off in "48" {
                        out_u16_const(off - '0')
                        put(di_rev)
                        put(di_rev + 1)
                        out_const(0)
                        out_const(0)
                    }
                    ; driver version 1.0
                    out_u16_const(12)
                    out_const(0)
                    out_const(0)
                    out_const(1)
                    out_const(0)
                    clear(di_pend)
                }
                clear(present)
                clear(size)
                clear(bad)
            }
        }
        if_eq(m, 3) { di_return(HR_UNSUPPORTED) }
        if_gt_const(m, 3) {
            if_z(di_act) { di_return(HR_NOTINIT) }
            if_nz(di_act) {
                ; the interface id (always the steering axis) is not needed
                local skip[3] { w_read_u32(skip) w_clear(skip) }
                w_copy(di_now, e_now)
                if_eq(m, 4) {
                    local g { read_u32_cell(g) min_const(g, FULL) move(g, e_arg) }
                    set(e_cmd, EC_GAIN)
                    set(svc, K_DI_OK)
                }
                if_eq(m, 5) {
                    local c[3], lo, known {
                        w_read_u32(c)
                        ; commands are single bits of the low byte
                        if_z(c + 1) { if_z(c + 2) { copy(c, lo) } }
                        if_eq(lo, 0x01) { set(e_cmd, EC_RESET) }
                        if_eq(lo, 0x02) { set(e_cmd, EC_STOPALL) }
                        if_eq(lo, 0x04) { set(e_cmd, EC_PAUSE) }
                        if_eq(lo, 0x08) { set(e_cmd, EC_CONTINUE) }
                        if_eq(lo, 0x10) { set(e_cmd, EC_ACTUATORS) set(e_arg, 1) }
                        if_eq(lo, 0x20) { set(e_cmd, EC_ACTUATORS) }
                        if_nz_else(e_cmd) { set(svc, K_DI_OK) } { di_return(HR_INVALID) }
                        w_clear(c)
                        clear(lo)
                    }
                }
                if_eq(m, 6) {
                    local present, size, bad {
                        frame_in(present)
                        read_u32_cell(size)
                        lt_const(size, 12, bad)
                        if_z(present) { set(bad, 1) }
                        if_nz_else(bad) { di_return(HR_INVALID) } {
                            set(e_cmd, EC_ANY)
                            set(svc, K_DI_STATE)
                        }
                        clear(present)
                        clear(size)
                        clear(bad)
                    }
                }
                if_eq(m, 7) {
                    local present, bad {
                        read_u32_cell(di_eid)
                        frame_in(present)
                        read_u32_cell(di_hdl)
                        lt_const(di_eid, 1, bad)
                        gt_const(di_eid, 11, bad)
                        if_z(present) { set(bad, 1) }
                        if_nz_else(bad) { di_return(HR_INVALID) } {
                            copy(di_hdl, e_h)
                            set(e_cmd, EC_GET)
                            set(svc, K_DL1)
                        }
                        clear(present)
                        clear(bad)
                    }
                }
                if_eq(m, 8) {
                    read_u32_cell(e_h)
                    set(e_cmd, EC_DESTROY)
                    set(svc, K_DI_STATUS)
                }
                if_eq(m, 9) {
                    read_u32_cell(e_h)
                    local mode[3] {
                        w_read_u32(mode)
                        local q, r { copy(mode, q) divmod_const(q, 2, r, e_solo) clear(r) }
                        w_clear(mode)
                    }
                    w_read_u32(e_iter)
                    if_eq(e_iter, 65535) { if_eq(e_iter + 1, 65535) {
                        w_clear(e_iter)
                        set(e_iter_inf, 1)
                    } }
                    set(e_cmd, EC_START)
                    set(svc, K_DI_STATUS)
                }
                if_eq(m, 10) {
                    read_u32_cell(e_h)
                    set(e_cmd, EC_STOP)
                    set(svc, K_DI_STATUS)
                }
                if_eq(m, 11) {
                    local present {
                        read_u32_cell(e_h)
                        frame_in(present)
                        if_nz_else(present) {
                            set(e_cmd, EC_PLAYING)
                            set(svc, K_DI_PLAYING)
                        } { di_return(HR_INVALID) }
                        clear(present)
                    }
                }
                if_z(svc) { eng_inputs_clear() }
            }
        }
        clear(m)
    }
}

; ---------------------------------------------------------------------------
; Continuations
; ---------------------------------------------------------------------------

macro di_reply_download() {
    if_nz_else(di_newh) {
        di_header(11)
        out_hresult(HR_OK)
        out_const(1)
        di_output(0, di_hdl)
        clear(di_pend)
    } { di_return(HR_OK) }
    clear(di_newh)
    clear(di_hdl)
    clear(di_eid)
    clear(di_exist)
    for i = 0 to 3 { clear(di_chg + i) }
    eng_inputs_clear()
}

macro di_continue(k) {
    if_eq(k, K_NOP) {
        w_clear(st_now)
        w_clear(st_raw)
    }
    if_eq(k, K_TICK1) { di_tick1() }
    if_eq(k, K_TICK2) { di_tick2() }
    if_eq(k, K_DI_OK) {
        di_return(HR_OK)
        eng_inputs_clear()
    }
    if_eq(k, K_DI_STATUS) {
        if_nz_else(e_status) { di_return(HR_INVALID) } { di_return(HR_OK) }
        eng_inputs_clear()
    }
    if_eq(k, K_DI_PLAYING) {
        if_nz_else(e_status) { di_return(HR_INVALID) } {
            di_header(11)
            out_hresult(HR_OK)
            out_const(1)
            di_output(0, e_result)
            clear(di_pend)
        }
        eng_inputs_clear()
    }
    if_eq(k, K_DI_STATE) {
        ; DIGFFS_* bits: power on, empty, stopped, paused, actuators, device lost
        local b, load {
            set(b, 0x40)
            if_z(e_count) { add(b, 0x01) }
            if_z(e_result) { add(b, 0x02) }
            if_nz(e_paused) { add(b, 0x04) }
            if_nz_else(e_act) { add(b, 0x10) } { add(b, 0x20) }
            local c { copy_mul(e_count, c, 100) div_const(c, 32, load) }
            di_header(17)
            out_hresult(HR_OK)
            out_const(2)
            out_u16_const(4)
            put(b)
            out_const(0)
            out_const(0)
            if_nz_else(di_lost) { out_const(0x80) } { out_const(0) }
            di_output(8, load)
            clear(di_pend)
            clear(b)
            clear(load)
        }
        eng_inputs_clear()
    }
    if_eq(k, K_DL1) {
        ; an existing effect keeps its parameters; a new one starts from defaults
        clear(di_exist)
        if_z(e_status) { if_nz(di_hdl) { set(di_exist, 1) } }
        if_z(di_exist) {
            for f = 0 to 51 { clear(gp + f) }
            copy(di_eid, gp + FX_KIND)
            set(gp + FX_DUR_INF, 1)
            set(gp + FX_GAIN, FULL)
        }
        local match {
            eq(gp + FX_KIND, di_eid, match)
            if_nz_else(match) {
                set(ap_req, 1)
                set(svc, K_DL2)
            } {
                di_return(HR_INVALID)
                clear(di_hdl)
                clear(di_eid)
                clear(di_exist)
                eng_inputs_clear()
            }
            clear(match)
        }
    }
    if_eq(k, K_DL2) {
        if_nz_else(di_inv) {
            di_return(HR_INVALID)
            clear(di_inv)
            clear(di_hdl)
            clear(di_eid)
            clear(di_exist)
            for i = 0 to 3 { clear(di_chg + i) }
            eng_inputs_clear()
        } {
            if_nz_else(di_exist) {
                clear(e_h)
                copy(di_hdl, e_h)
                set(e_cmd, EC_UPDATE)
                set(svc, K_DL3)
            } {
                local full {
                    ge_const(e_count, SLOTS, full)
                    if_nz_else(full) {
                        di_return(HR_FULL)
                        clear(di_hdl)
                        clear(di_eid)
                        for i = 0 to 3 { clear(di_chg + i) }
                        eng_inputs_clear()
                    } {
                        set(di_newh, 1)
                        set(e_cmd, EC_CREATE)
                        set(svc, K_DL3)
                    }
                    clear(full)
                }
            }
        }
    }
    if_eq(k, K_DL3) {
        local st {
            copy(e_status, st)
            if_eq(st, 2) { di_return(HR_FULL) }
            if_eq(st, 1) { di_return(HR_INVALID) }
            if_eq(st, 3) { di_return(HR_INVALID) }
            if_nz_else(st) {
                clear(di_newh)
                clear(di_hdl)
                clear(di_eid)
                clear(di_exist)
                for i = 0 to 3 { clear(di_chg + i) }
                eng_inputs_clear()
            } {
                if_nz(di_newh) {
                    clear(di_hdl)
                    copy(e_result, di_hdl)
                }
                local start {
                    ; DIEP_START = 0x20000000: bit 5 of the top byte
                    bit_of(di_chg + 3, 32, start)
                    if_nz_else(start) {
                        eng_inputs_clear()
                        copy(di_hdl, e_h)
                        set(e_iter, 1)
                        w_copy(di_now, e_now)
                        set(e_cmd, EC_START)
                        set(svc, K_DL4)
                    } { di_reply_download() }
                    clear(start)
                }
            }
            clear(st)
        }
    }
    if_eq(k, K_DL4) { di_reply_download() }
}

; Every event in role DIRECTINPUT.
macro on_directinput() {
    local known {
        if_eq(fr_type, EV_TIMER) { set(known, 1) di_on_timer() }
        if_eq(fr_type, EV_HID_INPUT) {
            set(known, 1)
            local t[4], mine {
                for k = 0 to 3 { frame_in(t + k) }
                token_is_ours(t, mine)
                local reading {
                    if_nz(di_act) { set(reading, 1) }
                    if_eq(di_step, DS_POLL) { set(reading, 1) }
                    if_z(reading) { clear(mine) }
                    clear(reading)
                }
                if_nz(mine) {
                    w_read_u32(st_raw)
                    w_read_u64(st_now)
                    set(st_req, 2)
                    set(svc, K_NOP)
                }
                clear(mine)
                for k = 0 to 3 { clear(t + k) }
            }
        }
        if_eq(fr_type, EV_HID_WRITE_RESULT) {
            set(known, 1)
            local t[4], mine, err {
                for k = 0 to 3 { frame_in(t + k) }
                token_is_ours(t, mine)
                read_u32_nz(err)
                if_z(di_act) { clear(mine) }
                if_nz(mine) {
                    if_nz(err) {
                        if_z(di_lost) {
                            ; legacy: the force loop ends; DirectInput sees DIGFFS_DEVICELOST
                            set(di_lost, 1)
                            emit_timer_cancel()
                        }
                    }
                }
                clear(mine)
                clear(err)
                for k = 0 to 3 { clear(t + k) }
            }
        }
        if_eq(fr_type, EV_HID_DISCONNECTED) { set(known, 1) }
        local step_event {
            if_eq(fr_type, EV_HID_OPEN_RESULT) { set(step_event, 1) }
            if_eq(fr_type, EV_HID_USAGE_RESULT) { set(step_event, 1) }
            if_eq(fr_type, EV_HID_POLL_RESULT) { set(step_event, 1) }
            if_eq(fr_type, EV_SHM_RESULT) { set(step_event, 1) }
            if_nz(step_event) {
                set(known, 1)
                if_nz(di_step) { di_on_step_result() }
            }
            clear(step_event)
        }
        if_z(known) {
            local call {
                ge_const(fr_type, EV_DI_FIRST, call)
                gt_const(fr_type, EV_DI_LAST, call)
                ; call = 1 only inside the range (2 above it)
                if_eq(call, 1) { set(known, 1) di_call() }
                clear(call)
            }
        }
        if_z(known) { emit_abi_error(17) }
        clear(known)
    }
}

; ===========================================================================
; frame.bfa - reading event frames and writing command frames (ABI.md)
; ===========================================================================
;
; Uses the frame cells declared in layout.bfa:
;   fr_magic fr_version fr_type fr_flags fr_seq_lo fr_seq_hi fr_len_lo fr_len_hi
;   fr_len (total payload length), fr_rem (payload bytes not yet read),
;   fr_bad (header invalid), fr_short (a handler read past the payload).

; Reads one frame header and validates it. Afterwards fr_len = fr_rem = payload
; length and fr_bad = 1 when the frame is malformed (fatal).
macro frame_read_header() {
    clear(fr_len)
    clear(fr_rem)
    clear(fr_bad)
    clear(fr_short)
    get(fr_magic)
    get(fr_version)
    get(fr_type)
    get(fr_flags)
    get(fr_seq_lo)
    get(fr_seq_hi)
    get(fr_len_lo)
    get(fr_len_hi)
    copy(fr_len_lo, fr_len)
    local sixteen {
        ; fr_len += 256 * fr_len_hi
        copy_mul(fr_len_hi, sixteen, 16)
        move_mul(sixteen, fr_len, 16)
    }
    copy(fr_len, fr_rem)
    if_ne(fr_magic, 0xA5) { set(fr_bad, 1) }
    if_ne(fr_version, 1) { set(fr_bad, 1) }
    gt_const(fr_len, 4096, fr_bad)
    min_const(fr_bad, 1)
}

; x = next payload byte, or 0 (and fr_short = 1) when the payload is exhausted.
macro frame_in(x) {
    clear(x)
    if_nz_else(fr_rem) {
        get(x)
        @fr_rem -
    } {
        set(fr_short, 1)
    }
}

; x = next payload u16.   x: zero on entry
macro frame_in_u16(x) {
    local lo, hi {
        frame_in(lo)
        frame_in(hi)
        move(lo, x)
        local sixteen {
            move_mul(hi, sixteen, 16)
            move_mul(sixteen, x, 16)
        }
    }
}

; Discards the rest of the payload.
macro frame_skip() {
    local junk {
        while_nz(fr_rem) {
            get(junk)
            clear(junk)
            @fr_rem -
        }
    }
}

; Writes a frame header whose type is an assembly-time constant, with flags 0,
; the sequence of the frame being handled, and a constant payload length.
macro emit_reply_header(type, length) {
    out_const(0xA5)
    out_const(1)
    out_const(type)
    out_const(0)
    put(fr_seq_lo)
    put(fr_seq_hi)
    out_u16_const(length)
}

; Same, with sequence 0 (unsolicited).
macro emit_header(type, length) {
    out_const(0xA5)
    out_const(1)
    out_const(type)
    out_const(0)
    out_const(0)
    out_const(0)
    out_u16_const(length)
}

; CMD_EXIT with a constant status.
macro emit_exit(status) {
    emit_header(0x80, 4)
    out_const(status % 256)
    out_const(status / 256 % 256)
    out_const(status / 65536 % 256)
    out_const(status / 16777216 % 256)
}

; CMD_ABI_ERROR code, current event type.
macro emit_abi_error(code) {
    emit_reply_header(0x84, 2)
    out_const(code)
    put(fr_type)
}

; CMD_LOG with a constant severity and text.
macro emit_log(severity, text) {
    emit_header(0x81, 3 + len(text))
    out_const(severity)
    out_u16_const(len(text))
    out_str(text)
}

; CMD_CONSOLE_WRITE of constant text to stdout (1) or stderr (2).
macro emit_console(stream, text) {
    emit_header(0x82, 3 + len(text))
    out_const(stream)
    out_u16_const(len(text))
    out_str(text)
}

; flag += (a u32 payload field is not zero)
macro read_u32_nz(flag) {
    local b, nz {
        for k = 0 to 3 {
            frame_in(b)
            if_nz(b) { set(nz, 1) }
            clear(b)
        }
        move(nz, flag)
    }
}

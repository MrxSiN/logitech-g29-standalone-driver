; ===========================================================================
; wide.bfa - unsigned 48-bit numbers as three 16-bit limbs
; ===========================================================================
;
; A wide value w occupies cells w+0 (low limb), w+1, w+2 (high limb), each
; 0..65535 when normalized; value = w0 + 65536 w1 + 2^32 w2. Microsecond times
; below 2^48 (8.9 years) and every u32 fit. Helpers leave their results
; normalized unless stated. Scratch comes from the caller's nearest pool.

const LIMB16 = 65536

macro w_clear(a) {
    clear(a)
    clear(a + 1)
    clear(a + 2)
}

; b = a (b cleared first).   a: in
macro w_copy(a, b) {
    for i = 0 to 2 {
        clear(b + i)
        copy(a + i, b + i)
    }
}

; b += a; a = 0 (limb-wise, then normalized).
macro w_move_add(a, b) {
    for i = 0 to 2 { move(a + i, b + i) }
    w_norm(b)
}

; Carries limbs 0 and 1 above 65535 into the next limb.
macro w_norm(a) {
    for i = 0 to 1 {
        local q, r {
            divmod_const(a + i, LIMB16, q, r)
            move(r, a + i)
            move(q, a + i + 1)
        }
    }
}

; a += b.   b: in
macro w_add(a, b) {
    for i = 0 to 2 { copy(b + i, a + i) }
    w_norm(a)
}

; a -= b; requires a >= b.   b: in
macro w_sub(a, b) {
    local borrow {
        for i = 0 to 2 {
            if i < 2 { add(a + i, LIMB16) }
            copy_neg(b + i, a + i)
            if_nz(borrow) {
                @(a + i) -
            }
            clear(borrow)
            if i < 2 {
                local q, r {
                    divmod_const(a + i, LIMB16, q, r)
                    move(r, a + i)
                    ; q is 1 when no borrow is needed
                    @borrow +
                    move_neg(q, borrow)
                }
            }
        }
    }
}

; flag += (a >= b).   a, b: in
macro w_ge(a, b, flag) {
    local t[3], borrow {
        for i = 0 to 2 {
            copy(a + i, t + i)
            add(t + i, LIMB16)
            copy_neg(b + i, t + i)
            if_nz(borrow) { @(t + i) - }
            clear(borrow)
            local q, r {
                divmod_const(t + i, LIMB16, q, r)
                clear(r)
                @borrow +
                move_neg(q, borrow)
            }
        }
        if_z(borrow) { @flag + }
        clear(borrow)
    }
}

; flag += (a == 0)
macro w_is_zero(a, flag) {
    local nz {
        if_nz(a) { set(nz, 1) }
        if_nz(a + 1) { set(nz, 1) }
        if_nz(a + 2) { set(nz, 1) }
        if_z(nz) { @flag + }
        clear(nz)
    }
}

; flag += (a fits a cell below 2^31: high limb 0 and middle limb below 32768)
macro w_fits(a, flag) {
    local big {
        if_nz(a + 2) { set(big, 1) }
        gt_const(a + 1, 32767, big)
        if_z(big) { @flag + }
        clear(big)
    }
}

; a = x (0 <= x < 2^31).   x: in; a: cleared first
macro w_from_cell(x, a) {
    w_clear(a)
    local n, q {
        copy(x, n)
        divmod_const(n, LIMB16, q, a)
        move(q, a + 1)
    }
}

; x += a, for a value that fits a cell (w_fits).   a: in
macro w_to_cell(a, x) {
    copy(a, x)
    local t {
        copy_mul(a + 1, t, 256)
        move_mul(t, x, 256)
    }
}

; a *= k for a cell 0 <= k <= 32767; the product must stay below 2^48.
macro w_mul_cell(a, k) {
    for i = 0 to 2 {
        local p {
            mul(a + i, k, p)
            clear(a + i)
            move(p, a + i)
        }
    }
    w_norm(a)
}

macro w_mul_const(a, k) {
    assert k >= 0 && k <= 32767, "w_mul_const factor out of range"
    local c {
        add(c, k)
        w_mul_cell(a, c)
        clear(c)
    }
}

; a = a / k, r += a % k, for a cell 0 < k <= 32767.   r: zero on entry
macro w_div_cell(a, k, r) {
    for j = 0 to 2 {
        let i = 2 - j {
            local cur {
                ; cur = r * 65536 + limb
                move(r, cur)
                local t {
                    move_mul(cur, t, 256)
                    move_mul(t, cur, 256)
                }
                move(a + i, cur)
                divmod(cur, k, a + i, r)
            }
        }
    }
}

; a >>= 1, discarding the low bit.
macro w_half(a) {
    local two, r {
        add(two, 2)
        w_div_cell(a, two, r)
        clear(r)
        clear(two)
    }
}

; q = n / d, n = n % d (d > 0; q cleared first). Single-cell divmod when both
; values fit a cell, otherwise restoring binary long division over 48 bits.
macro w_divmod(n, d, q) {
    w_clear(q)
    local small {
        w_fits(n, small)
        w_fits(d, small)
        if_eq_else(small, 2) {
            local nn, dd, qq, rr {
                w_to_cell(n, nn)
                w_to_cell(d, dd)
                divmod(nn, dd, qq, rr)
                w_from_cell(qq, q)
                w_from_cell(rr, n)
                clear(qq)
                clear(rr)
                clear(dd)
            }
        } {
            local r[3], count {
                add(count, 48)
                times(count) {
                    local bit {
                        ; the top bit of n moves into the bottom of r
                        ge_const(n + 2, 32768, bit)
                        if_nz(bit) { add(n + 2, -32768) }
                        w_mul_const(n, 2)
                        w_mul_const(r, 2)
                        copy(bit, r)
                        clear(bit)
                        w_mul_const(q, 2)
                        w_ge(r, d, bit)
                        if_nz(bit) {
                            w_sub(r, d)
                            @q +
                        }
                        clear(bit)
                    }
                }
                w_clear(n)
                w_move_add(r, n)
            }
        }
        clear(small)
    }
}

; a = |a - b| and neg = 1 when a < b (neg cleared first).   b: in
macro w_sub_signed(a, b, neg) {
    clear(neg)
    local ge {
        w_ge(a, b, ge)
        if_nz_else(ge) { w_sub(a, b) } {
            local t[3] {
                w_copy(b, t)
                w_sub(t, a)
                w_clear(a)
                w_move_add(t, a)
            }
            set(neg, 1)
        }
        clear(ge)
    }
}

; Reads a u32 payload field into a (cleared first).
macro w_read_u32(a) {
    w_clear(a)
    local b {
        frame_in(b)
        move(b, a)
        frame_in(b)
        move_mul(b, a, 256)
        frame_in(b)
        move(b, a + 1)
        frame_in(b)
        move_mul(b, a + 1, 256)
    }
}

; Reads a u64 payload field; bits 48..63 are ignored (times stay below 2^48).
macro w_read_u64(a) {
    w_read_u32(a)
    local b {
        frame_in(b)
        move(b, a + 2)
        frame_in(b)
        move_mul(b, a + 2, 256)
        frame_in(b)
        clear(b)
        frame_in(b)
        clear(b)
    }
}

; Signed wide values are a sign cell (1 = negative) and a wide magnitude; zero
; is always stored with sign 0.

; (an, a) += (bn, b).   bn, b: in
macro ws_add(an, a, bn, b) {
    local same {
        eq(an, bn, same)
        if_nz_else(same) { w_add(a, b) } {
            local below {
                w_sub_signed(a, b, below)
                ; |b| was larger: the result takes b's sign
                if_nz(below) { clear(an) copy(bn, an) }
                clear(below)
            }
        }
        clear(same)
    }
    local z { w_is_zero(a, z) if_nz(z) { clear(an) } clear(z) }
}

; (an, a) -= (bn, b).   bn, b: in
macro ws_sub(an, a, bn, b) {
    local fn {
        if_z(bn) { set(fn, 1) }
        ws_add(an, a, fn, b)
        clear(fn)
    }
}

; One step of floor(x * k1 * k2 ... / d) with an exact remainder chain: on entry
; q = floor(X / d) for the factors so far and x = the remainder; on exit both
; include factor k (0 < k <= 4096). Requires d * k < 2^48 and the final
; quotient below 2^48.
macro w_scale_step(x, d, q, k) {
    assert k > 0 && k <= 4096, "w_scale_step factor out of range"
    w_mul_const(q, k)
    w_mul_const(x, k)
    local t[3] {
        w_divmod(x, d, t)
        w_move_add(t, q)
    }
}

; Writes the low 32 bits of a as a little-endian u32.   a: in
macro w_out_u32(a) {
    for i = 0 to 1 {
        local c, q, r {
            copy(a + i, c)
            divmod_const(c, 256, q, r)
            put(r)
            put(q)
            clear(q)
            clear(r)
        }
    }
}

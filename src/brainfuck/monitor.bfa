; ===========================================================================
; monitor.bfa - "g29ctl watch" and the Windows service (legacy WheelMonitor)
; ===========================================================================
;
; Every second: enumerate; when exactly one configurable G29 is present and its
; interface path differs (ignoring case) from the last configured one, run the
; initialization sequence and remember the path; when none or several are
; present, forget it. Failures are logged only when the message changes; a
; PS4-mode wheel is reported the same way. The service (mon_mode 2) goes idle
; after 15 s without a configurable G29 and asks the service host to stop it;
; watch (mon_mode 1) runs until Ctrl+C.
;
; Log lines go to stdout (watch) or to one event-log entry each (service).

const M_START = 110
const M_TICK = 111
const M_FOUND = 112
const M_CONFIGURED = 113
const M_INIT_FAIL = 114
const M_NEXT = 115
const M_IDLE_WAIT = 116
const M_EXIT = 117
const WA_1 = 120
const SV_1 = 125
const SV_2 = 126

const MON_TIMER = 2
const MON_IDLE_US = 15000000
const EV_SERVICE_STARTED = 0x40
const EV_SERVICE_STOP = 0x41
const EV_SERVICE_SHUTDOWN = 0x42

const K_PS4 = 1
const K_CONFIG = 2

macro mon_log_begin() {
    if_eq_else(mon_mode, 2) { set(sink, 3) } { set(sink, 1) }
}

macro mon_log_end() {
    if_eq_else(mon_mode, 2) {
        ; commit the pending text as one information entry
        emit_header(0x83, 3)
        out_const(0)
        out_u16_const(0)
    } {
        sink_text("\r\n")
    }
}

; Logs the message of kind mon_kind (with err[] for K_CONFIG) unless it is the
; same message as last time (LogChanged).
macro mon_log_changed() {
    local same {
        eq(mon_kind, mon_last, same)
        if_eq(mon_kind, K_CONFIG) {
            for k = 0 to 5 {
                local d {
                    eq(err + k, mon_last_err + k, d)
                    if_z(d) { clear(same) }
                    clear(d)
                }
            }
        }
        if_z(same) {
            clear(mon_last)
            copy(mon_kind, mon_last)
            cells_copy(err, mon_last_err, 6)
            mon_log_begin()
            if_eq(mon_kind, K_PS4) {
                sink_text("The G29 is in PS4 mode (PID C260), which this tool cannot configure. Set the selector to PS3 and reconnect USB.")
            }
            if_eq(mon_kind, K_CONFIG) {
                sink_text("G29 configuration failed: ")
                print_message()
            }
            mon_log_end()
        }
        clear(same)
    }
}

; Leaves the program (watch: exit 0; service: tells the host it is done).
macro mon_exit() {
    wd_close()
    set(cli_exit, 0)
    goto_state(S_EXIT)
}

; Shared option handling of watch and service: --range, --autocenter, and no
; other option (legacy NamedInteger + EnsureOnlyNamedArguments). Runs next()
; when the arguments are acceptable.
macro mon_options(next) {
    local bad, done {
        option_invalid(o_range, bad)
        if_nz(bad) {
            set(done, 1)
            set(err + E_NAME, N_OPT_RANGE)
            fail(M_NUMERIC)
        }
        clear(bad)
        if_z(done) {
            option_invalid(o_ac, bad)
            if_nz(bad) {
                set(done, 1)
                set(err + E_NAME, N_OPT_AUTOCENTER)
                fail(M_NUMERIC)
            }
            clear(bad)
        }
        if_z(done) {
            if_nz(ci_off) {
                set(done, 1)
                fail(M_UNKNOWN_OPTION)
            }
        }
        if_z(done) {
            ; the values are checked by the initialization, as in the legacy monitor
            option_value(o_range, v_range, 900)
            option_value(o_ac, v_ac, 0)
            next()
        }
        clear(done)
    }
}

macro st_monitor() {
    if_eq(cli_cur, WA_1) {
        mon_options() {
            con_text(1, "WATCHER AWAKENED. Waiting for a G29 to cross the USB threshold. Ctrl+C performs banishment.\r\n")
            set(mon_mode, 1)
            goto_state(M_START)
        }
    }
    if_eq(cli_cur, SV_1) {
        mon_options() {
            ; connect to the Service Control Manager as the G29Standalone service
            emit_header(0xB7, 2 + len("G29Standalone"))
            out_u16_const(len("G29Standalone"))
            out_str("G29Standalone")
            await_state(SV_2)
        }
    }
    if_eq(cli_cur, SV_2) {
        if_eq(fr_type, EV_SERVICE_STARTED) {
            consumed()
            ; the crash watchdog's heartbeat mapping first (watchdog.bfa, SV_3)
            wd_create()
            await_state(SV_3)
        }
    }
    if_eq(cli_cur, M_START) {
        clear(mon_last)
        clear(cfg_valid)
        set(mon_first, 1)
        emit_timer_const(MON_TIMER, 0)
        await_state(M_TICK)
    }
    if_eq(cli_cur, M_TICK) {
        if_eq(fr_type, EV_TIMER) {
            clear(t_id)
            copy(ev_tid, t_id)
            if_eq(t_id, MON_TIMER) {
                clear(t_now_hi)
                clear(t_now_lo)
                time_read(t_now_hi, t_now_lo)
                clear(cli_have)
                if_nz(mon_first) {
                    ; lastSeen starts at the first check
                    time_copy(t_now_hi, t_now_lo, mon_seen_hi, mon_seen_lo)
                    clear(mon_first)
                }
                set(find_ret, M_FOUND)
                goto_state(F_START)
            }
            frame_skip()
            clear(t_id)
        }
    }
    if_eq(cli_cur, M_FOUND) {
        if_nz(n_g29) { time_copy(t_now_hi, t_now_lo, mon_seen_hi, mon_seen_lo) }
        if_eq_else(n_g29, 1) {
            ; configured path == this device's path?
            clear(mon_diff)
            if_z(cfg_valid) { set(mon_diff, 1) }
            if_z(mon_diff) {
                local lengths {
                    eq(sel_path_len, cfg_path_len, lengths)
                    if_z(lengths) { set(mon_diff, 1) }
                    clear(lengths)
                }
            }
            if_z(mon_diff) { buf_diff(sel_path, cfg_path, mon_diff) }
            if_nz_else(mon_diff) {
                set(err_ret, M_INIT_FAIL)
                set(req_ret, IN_2)
                goto_state(R_START)
            } {
                goto_state(M_NEXT)
            }
            clear(mon_diff)
        } {
            clear(cfg_valid)
            if_z(n_g29) {
                if_nz(n_ps4) {
                    set(mon_kind, K_PS4)
                    mon_log_changed()
                    clear(mon_kind)
                }
            }
            goto_state(M_NEXT)
        }
    }
    if_eq(cli_cur, M_CONFIGURED) {
        set(err_ret, S_FAIL)
        buf_copy(sel_path, cfg_path)
        clear(cfg_path_len)
        copy(sel_path_len, cfg_path_len)
        set(cfg_valid, 1)
        clear(mon_last)
        mon_log_begin()
        sink_text("Configured ")
        sink_buf(sel_buf, sel_len)
        if_nz_else(sel_native) { sink_text(" (native).") } { sink_text(" (compatibility).") }
        mon_log_end()
        goto_state(M_NEXT)
    }
    if_eq(cli_cur, M_INIT_FAIL) {
        set(err_ret, S_FAIL)
        set(mon_kind, K_CONFIG)
        mon_log_changed()
        clear(mon_kind)
        cells_clear(err, 6)
        goto_state(M_NEXT)
    }
    if_eq(cli_cur, M_NEXT) {
        ; a pending watchdog stop runs before the next wait
        if_nz_else(wd_pending) { goto_state(WD_1) } {
            local idle {
                if_eq(mon_mode, 2) {
                    time_elapsed_ge(t_now_hi, t_now_lo, mon_seen_hi, mon_seen_lo, MON_IDLE_US, idle)
                }
                if_nz_else(idle) {
                    mon_log_begin()
                    sink_text("No configurable G29 connected. Monitor is going idle.")
                    mon_log_end()
                    ; CMD_SERVICE_STOP_SELF: the host stops the service, which then
                    ; delivers EV_SERVICE_STOP
                    emit_header(0xBE, 0)
                    await_state(M_IDLE_WAIT)
                } {
                    if_nz_else(mon_stop) { mon_exit() } {
                        emit_timer_const(MON_TIMER, 1000)
                        await_state(M_TICK)
                    }
                }
                clear(idle)
            }
        }
    }
}

; Stop requests while monitoring (Ctrl+C for watch, service stop/shutdown).
; While waiting between checks the monitor stops at once; during a check it
; finishes the check first, like the legacy loop.
macro mon_async_stop() {
    set(mon_stop, 1)
    local now {
        if_eq(cli_state, M_TICK) { set(now, 1) }
        if_eq(cli_state, M_IDLE_WAIT) { set(now, 1) }
        if_nz(now) {
            emit_header(0xA1, 1)
            out_const(MON_TIMER)
            clear(cli_wait)
            mon_exit()
        }
        clear(now)
    }
}

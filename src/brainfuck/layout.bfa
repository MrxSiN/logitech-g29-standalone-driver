; ---- 740..799: scratch for registration and doctor ----
scratch 740 to 800

; ---- 800..889: effect engine globals (engine.bfa) ----
cell e_next       = 800
cell e_count      = 801
cell e_gain       = 802
cell e_act        = 803
cell e_paused     = 804
cell e_paused_at[3] = 805
cell e_h          = 808
cell e_now[3]     = 809
cell e_solo       = 812
cell e_iter_inf   = 813
cell e_iter[3]    = 814
cell e_status     = 817
cell e_result     = 818
cell e_res_neg    = 819
; motion: position, velocity, acceleration as sign/magnitude pairs
cell e_motion[6]  = 820
cell e_cmd        = 826
cell e_walk       = 827
cell e_shift[3]   = 828
cell e_arg        = 831
; staged effect parameters, laid out like a record (engine.bfa field offsets)
cell gp[52]       = 832
; steering request for the services (1 axis, 2 sample, 3 motion) and the
; role TEST steering operation being answered
cell st_req       = 884
cell tw_op        = 885

; ---- 890..933: steering motion (steering.bfa) ----
; signed wide values: sign cell (1 = negative) + three 16-bit limbs
cell st_has       = 890
cell st_last[3]   = 891
cell st_pn        = 894
cell st_p[3]      = 895
cell st_vn        = 898
cell st_v[3]      = 899

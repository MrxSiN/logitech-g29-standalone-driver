cell clsid_len    = 722
cell lib64_present = 723
cell lib64_len    = 724
cell cb64_present = 725
cell cb64_len     = 726
cell lib32_present = 727
cell lib32_len    = 728
cell cb32_present = 729
cell cb32_len     = 730

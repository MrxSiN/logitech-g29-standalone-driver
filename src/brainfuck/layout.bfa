; ===========================================================================
; layout.bfa - the tape map. MEMORY_MAP.md documents every region; change
; addresses only together with that file.
; ===========================================================================

; ---- 0..15: current event frame ----
cell fr_magic   = 0
cell fr_version = 1
cell fr_type    = 2
cell fr_flags   = 3
cell fr_seq_lo  = 4
cell fr_seq_hi  = 5
cell fr_len_lo  = 6
cell fr_len_hi  = 7
cell fr_len     = 8
cell fr_rem     = 9
cell fr_bad     = 10
cell fr_short   = 11
cell handled    = 12

; ---- 16..47: program state ----
cell running      = 16
cell booted       = 17
cell role         = 18
cell test_counter = 19
; shared services: the continuation to run after the steering and engine
; requests of the current event (see run_services in g29-main.bfa)
cell svc          = 20

; ---- 48..191: scratch for the frame layer and dispatcher ----
scratch 48 to 192

; ---- 192..215: protocol (protocol.bfa) ----
cell pr_arg1   = 192
cell pr_arg2   = 193
cell pr_arg3   = 194
cell pr_arg4   = 195
cell pr_flags  = 196
cell pr_count  = 197
cell pr_status = 198
cell test_sel  = 199
cell rpt[14]   = 200

; ---- 216..319: scratch for protocol helpers ----
scratch 216 to 320

; ---- 320..459: CLI (cli.bfa) ----
cell cli_state   = 320
cell cli_cur     = 321
cell cli_wait    = 322
cell cli_have    = 323
cell cli_argc    = 324
cell cli_argi    = 325
cell cli_cmd     = 326
cell cli_help    = 327
cell cli_exit    = 328
cell cli_print   = 329
; argument being parsed
cell ap_pos      = 330
cell ap_len      = 331
cell ap_b        = 332
cell ap_low      = 333
cell ap_dd0      = 334
cell ap_dd       = 335
cell ap_st       = 336
cell ap_neg      = 337
cell ap_mag      = 338
cell ap_min      = 339
cell ap_ovf      = 340
cell ap_kw       = 341
cell ap_kept     = 342
cell ap_valid    = 343
cell ap_m[20]    = 344
cell ap_oh[16]   = 364
; command-argument state
cell ci_want     = 380
cell ci_skip     = 381
cell ci_off      = 382
cell ci_off_len  = 383
cell ci_iu       = 384
cell ci_index    = 385
cell a0_len      = 386
; integer arguments: found, valid, negative, magnitude, minimum
cell p0[5]       = 387
cell o_range[5]  = 392
cell o_ac[5]     = 397
cell o_ms[5]     = 402
; error and pending error: message, name, negative, magnitude, minimum, number
cell err[6]      = 407
cell pend[6]     = 413
cell err_ret     = 419
; controller
cell find_ret    = 420
cell req_ret     = 421
cell send_ret    = 422
cell wn_ret      = 423
cell req_native  = 424
cell n_g29       = 425
cell n_ps4       = 426
cell n_nat       = 427
cell sel_tok[4]  = 428
cell sel_native  = 432
cell sel_out     = 433
cell sel_len     = 434
cell nat_tok[4]  = 435
cell nat_out     = 439
cell nat_len     = 440
cell w_index     = 441
cell in_force    = 442
cell cancelled   = 443
; device being enumerated (EV_HID_DEVICE)
cell d_tok[4]    = 444
cell d_vid_lo    = 448
cell d_vid_hi    = 449
cell d_pid_lo    = 450
cell d_pid_hi    = 451
cell d_rev_lo    = 452
cell d_rev_hi    = 453
cell d_page_lo   = 454
cell d_page_hi   = 455
cell d_use_lo    = 456
cell d_use_hi    = 457
cell d_in        = 458
cell d_out       = 459
cell d_len       = 460
cell d_cfg       = 461
cell d_ps4       = 462
cell d_native    = 463
; clock
cell t_start_hi  = 464
cell t_start_lo  = 465
cell t_now_hi    = 466
cell t_now_lo    = 467
cell t_id        = 468
; init values: negative, magnitude, minimum
cell v_range[3]  = 469
cell v_ac[3]     = 472
cell v_pct[3]    = 475
cell v_ms        = 478

; ---- 320..399 in roles DIRECTINPUT and TEST: DirectInput (dieffect.bfa,
; directinput.bfa). These cells overlay the CLI cells above, which only role
; CLI uses; a process runs exactly one role. ----
cell di_inv       = 320
cell di_chg[4]    = 321
cell di_full      = 325
cell di_fdur      = 326
cell di_fgain     = 327
cell di_fdir      = 328
cell di_fenv      = 329
cell di_fts       = 330
cell di_fdelay    = 331
; DIEFFECT request for the services (di_apply)
cell ap_req       = 332
; session
cell di_act       = 333
cell di_tok[4]    = 334
cell di_rev[2]    = 338
cell di_lost      = 340
cell di_sent      = 341
cell di_ln        = 342
cell di_lm        = 343
cell di_heart     = 344
cell di_hh[4]     = 345
cell di_step      = 349
; the pending DirectInput call: method (1..11) and its sequence
cell di_pend      = 350
cell di_sq[2]     = 351
cell di_now[3]    = 353
; system tick of the last timer event (8 bytes, for the heartbeat)
cell di_tms[8]    = 356
cell di_poll[3]   = 364
cell di_polled    = 367
; DownloadEffect
cell di_eid       = 368
cell di_hdl       = 369
cell di_newh      = 370
cell di_exist     = 371

; ---- 480..599: scratch for the CLI ----
scratch 480 to 600

; ---- 1000..4095: text buffers, interleaved as twelve lanes (print.bfa) ----
; Byte k of the buffer in lane j is cell BUF_BASE + j + k * BUF_STRIDE. Row -1
; (1000..1011) is the zero sentinel row and row 256 (4084..4095) the zero guard
; row. Lanes 5, 10 and 11 are scratch lanes for copying and comparing.
const BUF_SIZE   = 256
const BUF_STRIDE = 12
const BUF_BASE   = 1012
cell cur_buf     = 1012
cell a0_buf      = 1013
cell off_buf     = 1014
cell sel_buf     = 1015
cell nat_buf     = 1016
const BUF_TMP    = 1017
cell cur_path    = 1018
cell sel_path    = 1019
cell nat_path    = 1020
cell cfg_path    = 1021
const BUF_TMP2   = 1022
const BUF_FLAG   = 1023

; ---- 4100..4199: scratch next to the buffers ----
scratch 4100 to 4200

; ---- 600..629: monitor and service (monitor.bfa) ----
cell mon_mode     = 600
cell mon_stop     = 601
cell mon_seen_hi  = 602
cell mon_seen_lo  = 603
cell mon_last     = 604
cell mon_last_err[6] = 605
cell mon_kind     = 611
cell sink         = 612
cell cur_path_len = 613
cell sel_path_len = 614
cell nat_path_len = 615
cell cfg_path_len = 616
cell cfg_valid    = 617
cell mon_diff     = 618
cell mon_first    = 619
; timer id of the current EV_TIMER (read before the state machine runs)
cell ev_tid       = 620
; force-feedback crash watchdog (watchdog.bfa)
cell wd_on        = 621
cell wd_reading   = 622
cell wd_pending   = 623
cell wd_h[4]      = 624
cell wd_now[3]    = 628

; ---- 631..699: scratch for the monitor ----
scratch 631 to 700



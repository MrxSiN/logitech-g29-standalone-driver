; ===========================================================================
; engine_test.bfa - role TEST entry points for the effect engine
; ===========================================================================
;
; EV_TEST 'G' + operation drives the engine directly, so the frozen legacy
; transcripts (tests/reference/ffb-engine.txt) can be replayed. Every answer is
; CMD_TEST_RESULT: status u8 (0 ok, 1 unknown handle, 2 full, 3 out of range),
; negative u8, value u32.
;
;   c params            create           -> value = handle
;   u handle params     update
;   s handle iter_inf u8, iterations u32, solo u8, now u64   start
;   p handle / d handle stop / destroy
;   A / R               stop all / reset
;   P now / C now       pause / continue
;   a on u8 / g gain u32 actuators / device gain
;   f now, position, velocity, acceleration (sign u8 + u32 each)  force
;   y handle now        playing          -> value 0/1
;   n now               any playing      -> value 0/1
;   k / q / o           count / paused / actuators on
;   D params DIEFFECT   apply a serialized DIEFFECT (dieffect.bfa) to params
;                       -> status (0 ok, 3 invalid) + params (87 bytes)
;
; params: kind u8, duration u32 (FFFFFFFF = infinite), gain u32, delay u32,
; direction negative u8, envelope u8, attack level u32, attack time u32, fade
; level u32, fade time u32, magnitude (sign u8 + u32), ramp start, ramp end,
; offset (each sign + u32), phase u32, period u32, condition offset, positive
; coefficient, negative coefficient (sign + u32), positive saturation u32,
; negative saturation u32, dead band (sign + u32).

; x (cleared) = a u32 payload field, saturated at 2^30 when it does not fit.
macro read_u32_cell(x) {
    clear(x)
    local w[3], fits {
        w_read_u32(w)
        w_fits(w, fits)
        if_nz_else(fits) { w_to_cell(w, x) } { add(x, 1073741824) }
        w_clear(w)
        clear(fits)
    }
}

macro read_sm(n, m) {
    clear(n)
    frame_in(n)
    read_u32_cell(m)
    if_z(m) { clear(n) }
}

macro read_params() {
    for f = 0 to 51 { clear(gp + f) }
    frame_in(gp + FX_KIND)
    ; duration: FFFFFFFF means infinite
    w_read_u32(gp + FX_DUR)
    local inf {
        if_eq(gp + FX_DUR, 65535) { if_eq(gp + FX_DUR + 1, 65535) { set(inf, 1) } }
        if_nz(inf) { w_clear(gp + FX_DUR) set(gp + FX_DUR_INF, 1) }
        clear(inf)
    }
    read_u32_cell(gp + FX_GAIN)
    w_read_u32(gp + FX_DELAY)
    frame_in(gp + FX_DIR)
    frame_in(gp + FX_ENV)
    read_u32_cell(gp + FX_AL)
    w_read_u32(gp + FX_AT)
    read_u32_cell(gp + FX_FL)
    w_read_u32(gp + FX_FT)
    read_sm(gp + FX_MAG, gp + FX_MAG + 1)
    read_sm(gp + FX_RS, gp + FX_RS + 1)
    read_sm(gp + FX_RE, gp + FX_RE + 1)
    read_sm(gp + FX_OFF, gp + FX_OFF + 1)
    read_u32_cell(gp + FX_PHASE)
    w_read_u32(gp + FX_PERIOD)
    read_sm(gp + FX_CO, gp + FX_CO + 1)
    read_sm(gp + FX_PC, gp + FX_PC + 1)
    read_sm(gp + FX_NC, gp + FX_NC + 1)
    read_u32_cell(gp + FX_PS)
    read_u32_cell(gp + FX_NS)
    read_sm(gp + FX_DB, gp + FX_DB + 1)
}

macro engine_reply() {
    emit_reply_header(0x8F, 6)
    put(e_status)
    put(e_res_neg)
    out_u32(e_result)
}

macro test_engine() {
    local op {
        frame_in(op)
        clear(e_cmd)
        clear(e_arg)
        if_eq(op, 'c') { set(e_cmd, EC_CREATE) }
        if_eq(op, 'u') {
            set(e_cmd, EC_UPDATE)
            read_u32_cell(e_h)
        }
        local params {
            if_eq(op, 'c') { set(params, 1) }
            if_eq(op, 'u') { set(params, 1) }
            if_eq(op, 'D') { set(params, 1) }
            if_nz(params) { read_params() }
            clear(params)
        }
        if_eq(op, 's') {
            set(e_cmd, EC_START)
            read_u32_cell(e_h)
            clear(e_iter_inf)
            frame_in(e_iter_inf)
            w_read_u32(e_iter)
            clear(e_solo)
            frame_in(e_solo)
            w_read_u64(e_now)
        }
        if_eq(op, 'p') { set(e_cmd, EC_STOP) read_u32_cell(e_h) }
        if_eq(op, 'd') { set(e_cmd, EC_DESTROY) read_u32_cell(e_h) }
        if_eq(op, 'A') { set(e_cmd, EC_STOPALL) }
        if_eq(op, 'R') { set(e_cmd, EC_RESET) }
        if_eq(op, 'P') { set(e_cmd, EC_PAUSE) w_read_u64(e_now) }
        if_eq(op, 'C') { set(e_cmd, EC_CONTINUE) w_read_u64(e_now) }
        if_eq(op, 'a') { set(e_cmd, EC_ACTUATORS) frame_in(e_arg) }
        if_eq(op, 'g') { set(e_cmd, EC_GAIN) read_u32_cell(e_arg) }
        if_eq(op, 'f') {
            set(e_cmd, EC_FORCE)
            w_read_u64(e_now)
            for i = 0 to 2 { read_sm(e_motion + 2 * i, e_motion + 2 * i + 1) }
        }
        if_eq(op, 'y') { set(e_cmd, EC_PLAYING) read_u32_cell(e_h) w_read_u64(e_now) }
        if_eq(op, 'n') { set(e_cmd, EC_ANY) w_read_u64(e_now) }
        if_eq(op, 'k') { set(e_cmd, EC_COUNT) }
        if_eq(op, 'q') { set(e_cmd, EC_PAUSED) }
        if_eq(op, 'o') { set(e_cmd, EC_ACT_ON) }
        if_eq_else(op, 'D') {
            ; the DIEFFECT follows; the service applies it to the parameters
            set(ap_req, 1)
            set(svc, K_TEST_D)
        } {
            frame_skip()
            set(svc, K_TEST_G)
        }
        clear(op)
    }
}

; Continuation after the engine ran the command.
macro test_engine_done() {
    engine_reply()
    eng_inputs_clear()
}

; Engine inputs and results do not outlive a command.
macro eng_inputs_clear() {
    clear(e_cmd)
    clear(e_arg)
    clear(e_h)
    clear(e_solo)
    clear(e_iter_inf)
    w_clear(e_iter)
    w_clear(e_now)
    w_clear(e_shift)
    for i = 0 to 5 { clear(e_motion + i) }
    for f = 0 to 51 { clear(gp + f) }
    clear(e_status)
    clear(e_result)
    clear(e_res_neg)
}

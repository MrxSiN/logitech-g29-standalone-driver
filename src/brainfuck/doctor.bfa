; ===========================================================================
; doctor.bfa - g29ctl doctor (legacy ShowDoctor + HostDiagnostics)
; ===========================================================================
;
; Prints the status part, the running G HUB processes (in the order of the
; name list, one process scan per name) and which DirectInput force-feedback
; registration will be used: the per-user OEM registration first, then the
; machine one, and whether its class still points to an installed driver.

const DIAG_END = 7
const GHUB_NAMES = 5

; Runs then() when the text in buffer b (count bytes) equals text ignoring
; ASCII case; with suffix != 0, when it ends with text. Buffers keep the newest
; byte first, so both checks look at a fixed set of cells.
macro if_buf_text(b, count, text, suffix, then) {
    local ok, c {
        if suffix { ge_const(count, len(text), ok) } else { if_eq(count, len(text)) { set(ok, 1) } }
        if_nz(ok) {
            for i = 0 to len(text) - 1 {
                let want = byte(text, len(text) - 1 - i) {
                    clear(c)
                    copy(b + i * BUF_STRIDE, c)
                    @c -
                    lower_ascii(c)
                    if_ne(c, want >= 'A' && want <= 'Z' ? want + 32 : want) { clear(ok) }
                }
            }
        }
        if_nz(ok) { then() }
        clear(ok)
        clear(c)
    }
}

macro ghub_name(i, text) {
    if_eq(gh_index, i) { if_buf_text(cur_buf, rq_len, text, 0) { set(gh_match, 1) } }
}

; A library value: the InprocServer32 default value, or for a .NET COM server
; (mscoree.dll) the local path of its CodeBase ("file:///C:/..." -> "C:\...").
; Leaves the effective path's presence and length in eff_present / eff_len, and
; eff_cb = 1 when it comes from the CodeBase.
macro effective_library(lib_present, lib, lib_len, cb_present, cb, cb_len) {
    clear(eff_present)
    clear(eff_len)
    clear(eff_cb)
    if_nz(lib_present) {
        set(eff_present, 1)
        copy(lib_len, eff_len)
        if_nz(cb_present) {
            if_buf_text(lib, lib_len, "mscoree.dll", 1) {
                set(eff_cb, 1)
                clear(eff_len)
                copy(cb_len, eff_len)
                local eight {
                    set(eight, 8)
                    sub_sat(eff_len, eight)
                    clear(eight)
                }
            }
        }
    }
}

macro print_effective(lib, cb) {
    if_nz_else(eff_cb) {
        con_head(1, eff_len)
        put_buf_map_skip(cb, 8, '/', 92)
    } {
        con_buf(1, lib, eff_len)
    }
}

macro keep_string(present, count, b) {
    if_eq(rq_kind, 1) {
        set(present, 1)
        clear(count)
        copy(rq_len, count)
        buf_copy(cur_buf, b)
    }
}

macro diag_steps(final) {
    rstep(final, 1, { req_read(R_HKCU, V_DEFAULT, FF_KEY, "CLSID") }, {
        set(reg_step, 2)
        if_eq(rq_kind, 1) {
            if_nz(rq_len) {
                set(diag_source, R_HKCU)
                set(reg_step, 3)
            }
        }
    })
    rstep(final, 2, { req_read(R_HKLM, V_DEFAULT, FF_KEY, "CLSID") }, {
        set(reg_step, DIAG_END)
        if_eq(rq_kind, 1) {
            if_nz(rq_len) {
                set(diag_source, R_HKLM)
                set(reg_step, 3)
            }
        }
    })
    rstep(final, 3, {
        if_z(clsid_len) {
            buf_copy(cur_buf, CLSID_BUF)
            copy(rq_len, clsid_len)
        }
        req_class_server(OP_READ, R_HKLM, V_64, CLSID_BUF, clsid_len, "")
    }, { keep_string(lib64_present, lib64_len, LIB64_BUF) })
    rstep(final, 4, { req_class_server(OP_READ, R_HKLM, V_64, CLSID_BUF, clsid_len, "CodeBase") }, { keep_string(cb64_present, cb64_len, CB64_BUF) })
    rstep(final, 5, { req_class_server(OP_READ, R_HKLM, V_32, CLSID_BUF, clsid_len, "") }, { keep_string(lib32_present, lib32_len, LIB32_BUF) })
    rstep(final, 6, { req_class_server(OP_READ, R_HKLM, V_32, CLSID_BUF, clsid_len, "CodeBase") }, { keep_string(cb32_present, cb32_len, CB32_BUF) })
}

macro source_name() {
    if_eq_else(diag_source, R_HKCU) { con_text(1, "HKEY_CURRENT_USER") } { con_text(1, "HKEY_LOCAL_MACHINE") }
}

macro st_doctor() {
    if_eq(cli_cur, DR_1) {
        set(cli_print, 1)
        set(find_ret, DR_2)
        goto_state(F_START)
    }
    if_eq(cli_cur, DR_2) {
        ; the status part, as g29ctl status prints it
        clear(cli_print)
        if_nz_else(n_g29) { set(cli_exit, 0) } {
            if_nz_else(n_ps4) {
                con_text(1, "THE ORACLE SEES A G29 WEARING ITS PS4 MASK. The G29 is in PS4 mode (PID C260), which this tool cannot configure. Set the selector to PS3 and reconnect USB.\r\n")
            } {
                con_text(1, "THE ORACLE SEES NO LOGITECH G29. Check USB + PS3 mode.\r\n")
            }
            set(cli_exit, 2)
        }
        clear(gh_index)
        clear(gh_count)
        goto_state(DR_P)
    }
    if_eq(cli_cur, DR_P) {
        if_eq_else(gh_index, GHUB_NAMES) { goto_state(DR_PEND) } {
            emit_header(0xC0, 0)
            await_state(DR_PB)
        }
    }
    if_eq(cli_cur, DR_PB) {
        if_eq(fr_type, 0x20) {
            consumed()
            await_state(DR_PL)
        }
    }
    if_eq(cli_cur, DR_PL) {
        if_eq(fr_type, 0x21) {
            read_u32(gh_pid)
            local keep {
                set(keep, 1)
                dev_text(keep, cur_buf, rq_len, 0)
                clear(keep)
            }
            consumed()
            clear(gh_match)
            ghub_name(0, "lghub")
            ghub_name(1, "lghub_agent")
            ghub_name(2, "lghub_updater")
            ghub_name(3, "lghub_system_tray")
            ghub_name(4, "lghub_software_manager")
            if_nz(gh_match) {
                if_nz_else(gh_count) { con_text(1, ", ") } { con_text(1, "G HUB processes: ") }
                con_buf(1, cur_buf, rq_len)
                con_text(1, " (PID ")
                con_dec(1, gh_pid)
                con_text(1, ")")
                @gh_count +
            }
            clear(gh_match)
            clear(gh_pid)
            set(cli_wait, 1)
        }
        if_eq(fr_type, 0x22) {
            consumed()
            @gh_index +
            goto_state(DR_P)
        }
    }
    if_eq(cli_cur, DR_PEND) {
        if_nz_else(gh_count) { con_text(1, "\r\n") } { con_text(1, "G HUB processes: none running\r\n") }
        clear(diag_source)
        clear(clsid_len)
        clear(lib64_present)
        clear(cb64_present)
        clear(lib32_present)
        clear(cb32_present)
        set(reg_mode, 3)
        set(reg_step, 1)
        set(rs_done, DR_OUT)
        goto_state(RS_EXEC)
    }
    if_eq(cli_cur, DR_OUT) {
        local registered, orphaned {
            ; orphaned: a class ID whose 64-bit and 32-bit libraries are both missing
            effective_library(lib32_present, LIB32_BUF, lib32_len, cb32_present, CB32_BUF, cb32_len)
            if_nz(diag_source) {
                set(orphaned, 1)
                if_nz(eff_len) { clear(orphaned) }
            }
            effective_library(lib64_present, LIB64_BUF, lib64_len, cb64_present, CB64_BUF, cb64_len)
            if_nz(diag_source) {
                if_nz(eff_len) {
                    set(registered, 1)
                    clear(orphaned)
                }
            }
            if_nz(registered) {
                con_text(1, "DirectInput OEM force feedback: THE ANCIENT REGISTRATION EXISTS\r\n  Registered in: ")
                source_name()
                con_text(1, "\r\n  CLSID: ")
                con_buf(1, CLSID_BUF, clsid_len)
                con_text(1, "\r\n  64-bit driver: ")
                print_effective(LIB64_BUF, CB64_BUF)
                con_text(1, "\r\n  32-bit driver: ")
                effective_library(lib32_present, LIB32_BUF, lib32_len, cb32_present, CB32_BUF, cb32_len)
                if_nz_else(eff_present) { print_effective(LIB32_BUF, CB32_BUF) } {
                    con_text(1, "not registered (32-bit games get no force feedback)")
                }
                con_text(1, "\r\n")
            }
            if_nz(orphaned) {
                con_text(1, "DirectInput OEM force feedback: A GHOST REGISTRATION HAUNTS ")
                source_name()
                con_text(1, "\r\n  CLSID ")
                con_buf(1, CLSID_BUF, clsid_len)
                con_text(1, " points to a driver that is no longer installed (for example an uninstalled G HUB).\r\n  Run Install-Driver.ps1 to replace it with the G29Standalone driver.\r\n")
            }
            if_z(registered) {
                if_z(orphaned) {
                    con_text(1, "DirectInput OEM force feedback: THE ANCIENT REGISTRATION IS ABSENT\r\nAxes/buttons may still live; game-driven force effects may remain trapped beyond the veil.\r\n")
                }
            }
            clear(registered)
            clear(orphaned)
        }
        goto_state(S_EXIT)
    }
}

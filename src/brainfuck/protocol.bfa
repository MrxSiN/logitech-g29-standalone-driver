; ===========================================================================
; protocol.bfa - Logitech G29 identification and HID output reports
; ===========================================================================
;
; Verified protocol (do not change without evidence; see AGENT.md). Every report
; is 7 bytes. The helpers read their inputs from pr_arg1..pr_arg4 and leave
; pr_count reports in rpt[0..6] (and rpt[7..13] for the second report).
;
;   native mode     F8 0A 00 00 00 00 00  then  F8 09 05 01 01 00 00
;   range 40..900   F8 81 lo hi 00 00 00
;   autocenter 0    F5 00 00 00 00 00 00
;   autocenter p    FE 0D a a b 00 00  then  14 00 00 00 00 00 00
;   LEDs 0..31      F8 12 mask 00 00 00 00
;   force 0         13 00 00 00 00 00 00 (stop)
;   force +-m       11 08 (128 +- (127m + 50) / 100) 80 00 00 00
;
; Identification (pr_arg1 PID high, pr_arg2 PID low, pr_arg3 revision high,
; pr_arg4 revision low) sets pr_flags: bit 0 native, bit 1 configurable G29
; hardware, bit 2 PS4 mode. Known G29 revisions: high byte 89, or high byte 13
; with low byte 50..57. C24F is native; C294 C298 C299 C29A C29B need a known
; revision; C260 with a known revision is PS4 mode (never configured).

macro rpt_clear() {
    for i = 0 to 13 { clear(rpt + i) }
}

macro proto_identify() {
    clear(pr_flags)
    local known {
        if_eq(pr_arg3, 0x89) { set(known, 1) }
        if_eq(pr_arg3, 0x13) {
            local n, eighths {
                copy(pr_arg4, n)
                div_const(n, 8, eighths)
                if_eq(eighths, 0x0A) { set(known, 1) }
                clear(eighths)
            }
        }
        if_eq(pr_arg1, 0xC2) {
            if_eq(pr_arg2, 0x4F) { add(pr_flags, 3) }
            if_eq(pr_arg2, 0x94) { if_nz(known) { add(pr_flags, 2) } }
            if_eq(pr_arg2, 0x98) { if_nz(known) { add(pr_flags, 2) } }
            if_eq(pr_arg2, 0x99) { if_nz(known) { add(pr_flags, 2) } }
            if_eq(pr_arg2, 0x9A) { if_nz(known) { add(pr_flags, 2) } }
            if_eq(pr_arg2, 0x9B) { if_nz(known) { add(pr_flags, 2) } }
            if_eq(pr_arg2, 0x60) { if_nz(known) { add(pr_flags, 4) } }
        }
        clear(known)
    }
}

macro proto_native() {
    rpt_clear()
    set(rpt + 0, 0xF8)
    set(rpt + 1, 0x0A)
    set(rpt + 7, 0xF8)
    set(rpt + 8, 0x09)
    set(rpt + 9, 0x05)
    set(rpt + 10, 0x01)
    set(rpt + 11, 0x01)
    set(pr_count, 2)
}

; pr_arg1 = degrees (40..900, checked by the caller)
macro proto_range() {
    rpt_clear()
    set(rpt + 0, 0xF8)
    set(rpt + 1, 0x81)
    local n {
        copy(pr_arg1, n)
        divmod_const(n, 256, rpt + 3, rpt + 2)
    }
    set(pr_count, 1)
}

; pr_arg1 = percent (0..100, checked by the caller)
macro proto_autocenter() {
    rpt_clear()
    if_nz_else(pr_arg1) {
        local m, w, seg, c {
            ; magnitude = round(percent * 65535 / 100) = 655p + (35p + 50) / 100
            add(c, 655)
            mul(pr_arg1, c, m)
            clear(c)
            copy_mul(pr_arg1, w, 35)
            add(w, 50)
            div_const(w, 100, m)
            ; above AAAA?  (m + 21845) / 65536
            copy(m, w)
            add(w, 21845)
            div_const(w, 65536, seg)
            if_nz_else(seg) {
                ; upper segment: r = m - AAAA; a = 6 + 3r / AAAA; b = 128 + 3r / 514
                add(m, 0 - 0xAAAA)
                copy_mul(m, w, 3)
                div_const(w, 0xAAAA, rpt + 2)
                add(rpt + 2, 6)
                copy_mul(m, w, 3)
                div_const(w, 514, rpt + 4)
                add(rpt + 4, 128)
            } {
                ; lower segment: a = 3m / 21845; b = 64m / 21845
                copy_mul(m, w, 3)
                div_const(w, 21845, rpt + 2)
                copy_mul(m, w, 64)
                div_const(w, 21845, rpt + 4)
            }
            copy(rpt + 2, rpt + 3)
            clear(m)
            clear(seg)
        }
        set(rpt + 0, 0xFE)
        set(rpt + 1, 0x0D)
        set(rpt + 7, 0x14)
        set(pr_count, 2)
    } {
        set(rpt + 0, 0xF5)
        set(pr_count, 1)
    }
}

; pr_arg1 = mask (0..31, checked by the caller)
macro proto_leds() {
    rpt_clear()
    set(rpt + 0, 0xF8)
    set(rpt + 1, 0x12)
    copy(pr_arg1, rpt + 2)
    set(pr_count, 1)
}

macro proto_stop() {
    rpt_clear()
    set(rpt + 0, 0x13)
    set(pr_count, 1)
}

; pr_arg1 = 1 for a negative force, pr_arg2 = magnitude percent (0..100,
; checked by the caller). Zero is the stop report.
macro proto_force() {
    if_nz_else(pr_arg2) {
        rpt_clear()
        set(rpt + 0, 0x11)
        set(rpt + 1, 0x08)
        set(rpt + 2, 128)
        set(rpt + 3, 0x80)
        local scaled, w {
            copy_mul(pr_arg2, w, 127)
            add(w, 50)
            div_const(w, 100, scaled)
            if_nz_else(pr_arg1) { move_neg(scaled, rpt + 2) } { move(scaled, rpt + 2) }
        }
        set(pr_count, 1)
    } {
        proto_stop()
    }
}

; Writes the pr_count reports (7 or 14 bytes).
macro put_reports() {
    for i = 0 to 6 { put(rpt + i) }
    if_eq(pr_count, 2) {
        for i = 7 to 13 { put(rpt + i) }
    }
}
